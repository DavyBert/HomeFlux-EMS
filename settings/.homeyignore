# Generated output: Homey rebuilds this from the current source.
/.homeybuild/

# Repository, CI and editor files.
/.git/
/.github/
/.gitignore
/.gitattributes
/.editorconfig
/.vscode/
/.idea/

# Development documentation, tests and investigation reports.
/docs/
/DOCS/
/test/
/tests/
/investigation/
/coverage/
/.nyc_output/
/README.md
/DEPENDENCIES.txt
/top.txt

# Old source copies, temporary files and profiling output, at any depth.
*.precoherent
*.bak
*.orig
*.rej
*~
*.log
*.cpuprofile
*.heapprofile
*.heapsnapshot
__pycache__/
*.pyc
.DS_Store
Thumbs.db
Desktop.ini

# Local environment files and source archives in the project root.
/env.json
/.env
/.env.*
/*.zip
/*.tgz
/*.tar.gz

# Keep runtime code, dependencies, assets, locales, settings and widgets.
# Keep .homeycompose, manifests, package files, LICENSE, .homeychangelog.json,
# README.txt and README.<language>.txt available for building and publishing.
