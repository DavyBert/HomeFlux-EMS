      "values": [
        {
          "id": "yes",
          "title": {
            "en": "Yes",
            "nl": "Ja"
          }
        },
        {
          "id": "no",
          "title": {
            "en": "No",
            "nl": "Nee"
          }
        }
      ]
    },
    {
      "name": "charge_current",
      "type": "number",
