+// Axis text uses the existing bottom margin; plot/viewport dimensions stay fixed.
+function chartHourLabels(horizon,geometry){
+ const {L,R,W}=geometry,fontSize=20,gap=4,step=horizon<=24?3:6;
+ let hours=[];for(let h=0;h<horizon-.001;h+=step)hours.push(h);
+ hours.push(horizon);
+ const width=text=>Array.from(text).reduce((sum,c)=>sum+(c==='M'?.92:c==='A'||c==='P'?.76:c===':'?.34:.68),0)*fontSize;
+ const place=values=>{
+  const labels=values.map(hour=>{
+   const text=axisHour(hour),size=width(text),tickX=L+hour/horizon*(R-L);
+   return {hour,text,width:size,tickX,left:Math.max(0,Math.min(W-size,tickX-size/2)),fontSize};
+  });
+  for(let i=labels.length-2;i>=0;i--)labels[i].left=Math.min(labels[i].left,labels[i+1].left-gap-labels[i].width);
+  for(let i=0;i<labels.length;i++)labels[i].left=Math.max(0,labels[i].left,i?labels[i-1].left+labels[i-1].width+gap:0);
+  return labels.at(-1).left+labels.at(-1).width<=W+.001?labels:null;
+ };
+ let labels;
+ while(!(labels=place(hours))&&hours.length>2){
+  // Prefer six-hour anchors when AM/PM text cannot fit every three hours.
+  let remove=-1;
+  for(let i=hours.length-2;i>0;i--)if(hours[i]%6!==0){remove=i;break;}
+  if(remove<0)remove=hours.length-2;
+  hours.splice(remove,1);
+ }
+ return labels||place([0,horizon]);
+}
