{
  "id": "com.homeflux.ems",
  "version": "0.4.2",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#4F8A10",
  "name": {
    "en": "HomeFlux EMS",
    "nl": "HomeFlux EMS"
  },
  "description": {
    "en": "Coordinate batteries, solar and flexible loads around dynamic or fixed multi-tariff contracts while Peak Guard keeps grid peaks under control.",
    "nl": "Stem batterijen, zonne-energie en flexibele verbruikers af op dynamische of vaste meertarievencontracten, terwijl Peak Guard netpieken bewaakt."
  },
  "category": "energy",
  "tags": {
    "en": [
      "energy",
      "battery",
      "solar",
      "EMS",
      "peak shaving"
    ],
    "nl": [
      "energie",
      "batterij",
      "zonnepanelen",
      "EMS",
      "peak shaving"
    ]
  },
  "author": {
    "name": "Davy Bert"
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "getSettingsSnapshot": {
      "method": "GET",
      "path": "/settings-snapshot"
    },
    "getPlanning": {
      "method": "GET",
      "path": "/planning"
    },
    "refreshPlanning": {
      "method": "POST",
      "path": "/planning/refresh"
    },
    "simulatePlanning": {
      "method": "POST",
      "path": "/planning/simulate"
    },
    "setInput": {
      "method": "PUT",
      "path": "/input"
    },
    "refreshHomeyEnergy": {
      "method": "POST",
      "path": "/homey-energy/refresh"
    },
    "startChargeTest": {
      "method": "POST",
      "path": "/charge-test/start"
    },
    "confirmChargeTest": {
      "method": "POST",
      "path": "/charge-test/confirm"
    },
    "testEvOutput": {
      "method": "POST",
      "path": "/test/ev-output"
    },
    "testHvacOutput": {
      "method": "POST",
      "path": "/test/hvac-output"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "homepage": "https://github.com/DavyBert/HomeFlux-EMS",
  "support": "https://github.com/DavyBert/HomeFlux-EMS/issues"
}