{
  "id": "com.homeflux.ems",
  "version": "1.2.27",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "brandColor": "#4F8A10",
  "name": {
    "en": "HomeFlux EMS",
    "nl": "HomeFlux EMS",
    "fr": "HomeFlux EMS",
    "es": "HomeFlux EMS",
    "de": "HomeFlux EMS"
  },
  "description": {
    "en": "Your energy, managed differently",
    "nl": "Jouw energie, anders geregeld",
    "fr": "Your energy, managed differently",
    "es": "Your energy, managed differently",
    "de": "Your energy, managed differently"
  },
  "category": "energy",
  "tags": {
    "en": [
      "energy",
      "battery",
      "solar",
      "EMS",
      "peak shaving"
    ],
    "nl": [
      "energie",
      "batterij",
      "zonnepanelen",
      "EMS",
      "peak shaving"
    ],
    "fr": [
      "énergie",
      "batterie",
      "solaire",
      "EMS",
      "pic de rasage"
    ],
    "es": [
      "energía",
      "batería",
      "solar",
      "EMS",
      "afeitado pico"
    ],
    "de": [
      "Energie",
      "Batterie",
      "Solarenergie",
      "EMS",
      "Spitzenlastbegrenzung"
    ]
  },
  "author": {
    "name": "Davy Bert"
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "getHybridStatus": {
      "method": "GET",
      "path": "/hybrid-status"
    },
    "getSettingsSnapshot": {
      "method": "GET",
      "path": "/settings-snapshot"
    },
    "getDiagnostics": {
      "method": "GET",
      "path": "/diagnostics"
    },
    "resetDiagnostics": {
      "method": "POST",
      "path": "/diagnostics/reset"
    },
    "getPlanning": {
      "method": "GET",
      "path": "/planning"
    },
    "getSavings": {
      "method": "GET",
      "path": "/savings"
    },
    "getAutoTune": {
      "method": "GET",
      "path": "/auto-tune"
    },
    "refreshAutoTune": {
      "method": "POST",
      "path": "/auto-tune/refresh"
    },
    "setAutoTunePermission": {
      "method": "PUT",
      "path": "/auto-tune/permission"
    },
    "setAutoTuneLimits": {
      "method": "PUT",
      "path": "/auto-tune/limits"
    },
    "applyAutoTuneRecommendation": {
      "method": "POST",
      "path": "/auto-tune/apply"
    },
    "setAutoTuneIgnored": {
      "method": "PUT",
      "path": "/auto-tune/ignored"
    },
    "refreshPlanning": {
      "method": "POST",
      "path": "/planning/refresh"
    },
    "simulatePlanning": {
      "method": "POST",
      "path": "/planning/simulate"
    },
    "setInput": {
      "method": "PUT",
      "path": "/input"
    },
    "refreshHomeyEnergy": {
      "method": "POST",
      "path": "/homey-energy/refresh"
    },
    "startChargeTest": {
      "method": "POST",
      "path": "/charge-test/start"
    },
    "confirmChargeTest": {
      "method": "POST",
      "path": "/charge-test/confirm"
    },
    "testEvOutput": {
      "method": "POST",
      "path": "/test/ev-output"
    },
    "testHvacOutput": {
      "method": "POST",
      "path": "/test/hvac-output"
    },
    "getSavingsHistory": {
      "method": "GET",
      "path": "/savings/history"
    },
    "getSavingsExport": {
      "method": "GET",
      "path": "/savings/export"
    },
    "getInputMonitor": {
      "method": "GET",
      "path": "/input-monitor"
    },
    "startInputMonitor": {
      "method": "POST",
      "path": "/input-monitor/start"
    },
    "stopInputMonitor": {
      "method": "POST",
      "path": "/input-monitor/stop"
    },
    "clearInputMonitor": {
      "method": "POST",
      "path": "/input-monitor/clear"
    },
    "recheckHvac": {
      "method": "POST",
      "path": "/hvac/recheck"
    },
    "startBatteryResponseTest": {
      "method": "POST",
      "path": "/battery-response-test/start"
    },
    "stopBatteryResponseTest": {
      "method": "POST",
      "path": "/battery-response-test/stop"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "homepage": "https://github.com/DavyBert/HomeFlux-EMS",
  "support": "https://github.com/DavyBert/HomeFlux-EMS/issues"
}
