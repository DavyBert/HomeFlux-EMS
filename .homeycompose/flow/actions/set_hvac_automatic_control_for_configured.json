{
  "title": {
    "en": "Set HVAC automatic control",
    "nl": "Stel HVAC automatische sturing in"
  },
  "args": [
    {
      "name": "hvac",
      "type": "autocomplete",
      "title": {
        "en": "HVAC",
        "nl": "HVAC"
      },
      "placeholder": {
        "en": "Select configured HVAC",
        "nl": "Kies geconfigureerde HVAC"
      }
    },
    {
      "name": "enabled",
      "type": "dropdown",
      "title": {
        "en": "Automatic control",
        "nl": "Automatische sturing"
      },
      "values": [
        {
          "id": "yes",
          "title": {
            "en": "Yes",
            "nl": "Ja"
          }
        },
        {
          "id": "no",
          "title": {
            "en": "No",
            "nl": "Nee"
          }
        }
      ]
    },
    {
      "name": "standby_temperature",
      "type": "number",
      "required": false,
      "min": 5,
      "max": 99,
      "step": 0.5,
      "title": {
        "en": "Standby temperature (optional)",
        "nl": "Stand-bytemperatuur (optioneel)"
      },
      "placeholder": {
        "en": "Leave empty to retain setting",
        "nl": "Leeg = instelling behouden"
      }
    }
  ],
  "titleFormatted": {
    "en": "Set [[hvac]] automatic control to [[enabled]] (standby [[standby_temperature]] °C)",
    "nl": "Stel [[hvac]] automatische sturing in op [[enabled]] (stand-by [[standby_temperature]] °C)"
  },
  "hint": {
    "en": "When disabled, sends the standby temperature if specified and setpoint control is allowed. Also sends OFF when power control is allowed. Empty retains the saved standby setting. Only configured HVACs are offered.",
    "nl": "Bij Nee wordt de gekozen stand-bytemperatuur gestuurd als setpointsturing toegestaan is. Bij toegestane aan/uit-sturing wordt ook Uit gestuurd. Leeg behoudt de opgeslagen stand-byinstelling. Alleen geconfigureerde HVAC’s worden aangeboden."
  }
}
