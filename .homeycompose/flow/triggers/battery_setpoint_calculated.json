  "title": {
    "en": "New battery setpoint calculated",
    "nl": "Nieuw batterij-setpoint berekend",
    "fr": "Nouveau point de réglage de la batterie calculé",
    "es": "Nuevo punto de batería calculado",
    "de": "Neuer Batterie-Sollwert berechnet"
